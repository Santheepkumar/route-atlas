{
  "name": "route-atlas",
  "version": "0.1.4",
  "private": false,
  "description": "Local Next.js App Router atlas for routes, layouts, components, navigation, and data flow.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santheepkumar/route-atlas.git"
  },
  "homepage": "https://github.com/Santheepkumar/route-atlas#readme",
  "bugs": {
    "url": "https://github.com/Santheepkumar/route-atlas/issues"
  },
  "keywords": [
    "nextjs",
    "next",
    "app-router",
    "routes",
    "visualizer",
    "react-flow",
    "developer-tools"
  ],
  "bin": {
    "route-atlas": "bin/route-atlas.mjs"
  },
  "files": [
    ".next/standalone",
    "bin/route-atlas.mjs",
    "scripts/prepare-standalone.mjs",
    "src/app",
    "src/components",
    "src/lib/visualizer/scanner.ts",
    "src/lib/visualizer/route-utils.ts",
    "src/lib/visualizer/types.ts",
    "public",
    "docs",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "prepack": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "@xyflow/react": "^12.11.2",
    "babel-plugin-react-compiler": "1.0.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "vitest": "^4.1.10"
  }
}
